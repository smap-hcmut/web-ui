{
  "title": "Chart Data Formats Index",
  "description": "Tổng hợp tất cả định dạng dữ liệu cho các chart components trong SEO Controller Dashboard",
  "version": "1.0.0",
  "last_updated": "2025-12-17",
  
  "charts": {
    "unified_chart": {
      "file": "unified-chart-data.json",
      "interface": "UnifiedChartData[]",
      "component": "UnifiedChart",
      "description": "Biểu đồ tích hợp mentions, sentiment và critical events",
      "category": "analytics",
      "complexity": "high",
      "data_sources": ["mentions_api", "sentiment_api", "crisis_api"]
    },
    
    "topic_cloud": {
      "file": "topic-cloud-data.json", 
      "interface": "TopicData[]",
      "component": "TopicCloud",
      "description": "Word cloud hiển thị trending topics",
      "category": "content_analysis",
      "complexity": "medium",
      "data_sources": ["topics_api", "trends_api"]
    },
    
    "competitor_chart": {
      "file": "competitor-chart-data.json",
      "interface": "CompetitorData[]", 
      "component": "CompetitorChart",
      "description": "Biểu đồ so sánh Share of Voice",
      "category": "competitive_analysis",
      "complexity": "low",
      "data_sources": ["sov_api", "competitors_api"]
    },
    
    "sales_funnel": {
      "file": "sales-funnel-data.json",
      "interface": "FunnelStageData[]",
      "component": "SalesFunnel", 
      "description": "Phễu bán hàng với conversion rates",
      "category": "conversion_analysis",
      "complexity": "medium",
      "data_sources": ["funnel_api", "conversion_api"]
    },
    
    "data_table": {
      "file": "data-table-data.json",
      "interface": "ContentData[]",
      "component": "DataTable",
      "description": "Bảng content performance",
      "category": "content_analysis", 
      "complexity": "low",
      "data_sources": ["content_api", "engagement_api"]
    },
    
    "top_viral_posts": {
      "file": "top-viral-posts-data.json",
      "interface": "ViralPostData[]",
      "component": "TopViralPosts",
      "description": "Bảng viral posts với risk analysis",
      "category": "risk_management",
      "complexity": "high", 
      "data_sources": ["viral_api", "risk_api", "impact_api"]
    }
  },
  
  "categories": {
    "analytics": {
      "description": "Charts phân tích dữ liệu tổng quan",
      "charts": ["unified_chart"]
    },
    "content_analysis": {
      "description": "Charts phân tích nội dung và topics",
      "charts": ["topic_cloud", "data_table"]
    },
    "competitive_analysis": {
      "description": "Charts phân tích đối thủ cạnh tranh", 
      "charts": ["competitor_chart"]
    },
    "conversion_analysis": {
      "description": "Charts phân tích chuyển đổi và funnel",
      "charts": ["sales_funnel"]
    },
    "risk_management": {
      "description": "Charts quản lý rủi ro và crisis",
      "charts": ["top_viral_posts"]
    }
  },
  
  "complexity_levels": {
    "low": {
      "description": "Dữ liệu đơn giản, ít field, validation cơ bản",
      "charts": ["competitor_chart", "data_table"],
      "typical_fields": "3-5 fields",
      "validation_complexity": "Basic range/format checks"
    },
    "medium": {
      "description": "Dữ liệu trung bình, có calculated fields",
      "charts": ["topic_cloud", "sales_funnel"],
      "typical_fields": "5-8 fields", 
      "validation_complexity": "Business logic validation"
    },
    "high": {
      "description": "Dữ liệu phức tạp, nhiều nested objects",
      "charts": ["unified_chart", "top_viral_posts"],
      "typical_fields": "8+ fields with nested objects",
      "validation_complexity": "Complex cross-field validation"
    }
  },
  
  "common_field_types": {
    "identifiers": {
      "fields": ["id", "timestamp"],
      "validation": "unique, required",
      "examples": ["string", "number"]
    },
    "metrics": {
      "fields": ["mentions", "engagement", "reach", "sov"],
      "validation": "non-negative numbers",
      "examples": [1200, 8500, 125000, 26.2]
    },
    "percentages": {
      "fields": ["percentage", "sentiment.*", "change"],
      "validation": "0-100 range",
      "examples": [45, 20.5, 85.7]
    },
    "scores": {
      "fields": ["impact_score", "virality_index", "confidence"],
      "validation": "0-100 range",
      "examples": [85, 78, 0.85]
    },
    "enums": {
      "fields": ["risk", "trend", "platform"],
      "validation": "predefined values",
      "examples": ["CRITICAL", "rising", "Facebook"]
    },
    "colors": {
      "fields": ["color"],
      "validation": "hex format",
      "examples": ["#3b82f6", "#ef4444"]
    }
  },
  
  "data_relationships": {
    "unified_chart_dependencies": {
      "description": "UnifiedChart cần data từ nhiều sources",
      "sources": ["mentions", "sentiment", "critical_events"],
      "transformation": "chartDataTransform.ts"
    },
    "cross_chart_data": {
      "description": "Một số data có thể dùng chung giữa charts",
      "shared_fields": ["platform", "engagement", "reach"],
      "normalization": "Cần normalize platform names"
    }
  },
  
  "validation_patterns": {
    "required_fields": "Tất cả charts đều có required fields",
    "range_validation": "Scores và percentages có range validation", 
    "format_validation": "Dates, colors, enums có format validation",
