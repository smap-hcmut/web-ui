{
  "description": "Định dạng dữ liệu cho SalesFunnel - Biểu đồ phễu bán hàng hiển thị conversion rates",
  "interface": "FunnelStageData[]",
  "fields": {
    "stage": {
      "type": "string",
      "required": true,
      "description": "Tên giai đoạn trong phễu bán hàng",
      "example": "Awareness"
    },
    "count": {
      "type": "number",
      "required": true,
      "description": "Số lượng leads/users ở giai đoạn này",
      "example": 50000
    },
    "percentage": {
      "type": "number",
      "required": true,
      "description": "Phần trăm so với tổng số leads ban đầu",
      "range": "0-100",
      "example": 100
    },
    "change": {
      "type": "number",
      "required": true,
      "description": "Thay đổi so với kỳ trước (%)",
      "example": 5.2
    },
    "color": {
      "type": "string",
      "required": true,
      "description": "Màu sắc đại diện cho giai đoạn",
      "example": "#3b82f6"
    },
    "icon": {
      "type": "React.Component",
      "required": true,
      "description": "Icon component đại diện cho giai đoạn",
      "example": "Users"
    }
  },
  "sample_data": [
    {
      "stage": "Awareness",
      "count": 50000,
      "percentage": 100,
      "change": 5.2,
      "color": "#3b82f6",
      "icon": "Users"
    },
    {
      "stage": "Interest", 
      "count": 25000,
      "percentage": 50,
      "change": 3.8,
      "color": "#10b981",
      "icon": "MessageCircle"
    },
    {
      "stage": "Consideration",
      "count": 12500,
      "percentage": 25,
      "change": -2.1,
      "color": "#f59e0b",
      "icon": "ShoppingCart"
    },
    {
      "stage": "Purchase",
      "count": 2500,
      "percentage": 5,
      "change": 8.7,
      "color": "#ef4444",
      "icon": "DollarSign"
    }
  ],
  "calculated_metrics": {
    "conversion_rates": {
      "description": "Tỷ lệ chuyển đổi giữa các giai đoạn",
      "formula": "current_stage_count / previous_stage_count * 100",
      "example": {
        "awareness_to_interest": "50%",
        "interest_to_consideration": "50%", 
        "consideration_to_purchase": "20%"
      }
    },
    "drop_off_rates": {
      "description": "Tỷ lệ rời bỏ ở mỗi giai đoạn",
      "formula": "100 - conversion_rate",
      "example": {
        "awareness_drop_off": "50%",
        "interest_drop_off": "50%",
        "consideration_drop_off": "80%"
      }
    },
    "overall_conversion": {
      "description": "Tỷ lệ chuyển đổi tổng thể",
      "formula": "final_stage_count / first_stage_count * 100",
      "example": "5%"
    }
  },
  "validation_rules": {
    "stage_required": "stage không được rỗng",
    "count_positive": "count > 0",
    "percentage_range": "0 <= percentage <= 100",
    "color_format": "color phải là hex code hợp lệ",
    "descending_order": "count phải giảm dần qua các giai đoạn"
  },
  "chart_features": {
    "view_modes": ["count", "percentage"],
    "interaction": ["hover-details", "click-stage"],
    "display_type": "Horizontal bar chart",
    "animations": ["bar-grow", "fade-in"],
    "summary_stats": "Hiển thị tổng leads, converted, conversion rate, drop-off"
  },
  "icon_mapping": {
    "Users": "Awareness/Traffic stage",
    "MessageCircle": "Interest/Engagement stage", 
    "ShoppingCart": "Consideration/Intent stage",
    "DollarSign": "Purchase/Conversion stage"
  },
  "usage_notes": {
    "stage_order": "Các giai đoạn phải được sắp xếp theo thứ tự phễu",
    "percentage_calculation": "percentage = (count / first_stage_count) * 100",
    "color_progression": "Nên sử dụng màu sắc thể hiện progression",
    "performance_analysis": "change > 0 là cải thiện, change < 0 là giảm sút"
  }
}