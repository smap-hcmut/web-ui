{
  "description": "Định dạng dữ liệu cho TopicCloud - Word cloud hiển thị trending topics",
  "interface": "TopicData[]",
  "fields": {
    "text": {
      "type": "string",
      "required": true,
      "description": "Từ khóa/chủ đề",
      "example": "artificial intelligence"
    },
    "value": {
      "type": "number",
      "required": true,
      "description": "Tần suất/trọng số của bài viết chứa từ khóa xuất hiện có liên tiếp hay không",
      "example": 45
    },
    "sentiment": {
      "type": "number",
      "required": false,
      "range": "-1 to 1",
      "description": "Điểm cảm xúc (-1: tiêu cực, 0: trung tính, 1: tích cực)",
      "example": 0.7
    },
    "confidence": {
      "type": "number",
      "required": false,
      "range": "0-1",
      "description": "Độ tin cậy của phân tích",
      "example": 0.85
    },
    "trend": {
      "type": "enum",
      "values": ["rising", "falling", "stable"],
      "required": false,
      "description": "Xu hướng của từ khóa"
    },
    "mentions": {
      "type": "number",
      "required": false,
      "description": "Số lượng mentions",
      "example": 1250
    },
    "engagement": {
      "type": "number",
      "required": false,
      "description": "Tỷ lệ tương tác (%)",
      "example": 12.5
    }
  },
  "sample_data": [
    {
      "text": "artificial intelligence",
      "value": 45,
      "sentiment": 0.7,
      "confidence": 0.85,
      "trend": "rising",
      "mentions": 1250,
      "engagement": 12.5
    },
    {
      "text": "machine learning",
      "value": 38,
      "sentiment": 0.6,
      "confidence": 0.78,
      "trend": "stable",
      "mentions": 980,
      "engagement": 10.2
    },
    {
      "text": "data science",
      "value": 32,
      "sentiment": 0.4,
      "confidence": 0.72,
      "trend": "rising",
      "mentions": 850,
      "engagement": 8.9
    },
    {
      "text": "blockchain",
      "value": 28,
      "sentiment": -0.2,
      "confidence": 0.65,
      "trend": "falling",
      "mentions": 720,
      "engagement": 6.3
    },
    {
      "text": "cloud computing",
      "value": 25,
      "sentiment": 0.5,
      "confidence": 0.80,
      "trend": "stable",
      "mentions": 650,
      "engagement": 7.8
    }
  ],
  "validation_rules": {
    "text_required": "text không được rỗng",
    "value_positive": "value > 0",
    "sentiment_range": "-1 <= sentiment <= 1",
    "confidence_range": "0 <= confidence <= 1",
    "mentions_non_negative": "mentions >= 0",
    "engagement_non_negative": "engagement >= 0"
  },
  "usage_notes": {
    "word_cloud_limit": "Chỉ hiển thị tối đa 50 từ khóa có value cao nhất",
    "color_mapping": "Màu sắc dựa trên sentiment và trend",
    "size_mapping": "Kích thước từ dựa trên value",
    "interaction": "Click vào từ để xem chi tiết hoặc filter"
  }
}